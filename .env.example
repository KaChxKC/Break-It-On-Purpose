# Copy this file to `.env` and adjust as needed. `.env` is gitignored.

# --- Local Postgres (shared by docker-compose and the app) ---
POSTGRES_USER=biop
POSTGRES_PASSWORD=biop_local_pw
POSTGRES_DB=biop
POSTGRES_PORT=5432

# --- App database connection (SQLAlchemy + psycopg 3 driver) ---
DATABASE_URL=postgresql+psycopg://biop:biop_local_pw@localhost:5432/biop

# --- Connection pool ---
# Kept deliberately small so pool exhaustion is reproducible during chaos tests.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- App server ---
APP_HOST=0.0.0.0
APP_PORT=8000
WAITRESS_THREADS=8

# --- Observability ---
# Number of recent request durations retained for p50/p95/p99.
LATENCY_WINDOW=500
# Identifies which instance served a request. Falls back to the hostname if blank.
INSTANCE_ID=
